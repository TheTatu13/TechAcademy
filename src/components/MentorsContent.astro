---
import { mentors } from '../data/mentors';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang: 'ro' | 'en';
}

const { lang } = Astro.props;
const translatePath = useTranslatedPath(lang);

const copy = {
  ro: {
    eyebrow: 'Comunitate',
    title: 'Învață de la comunitate',
    text: 'Îndrumare de la voluntari cu experiență din comunitatea peViitor: întrebări despre cod, carieră și primii pași în open source.',
    contact: 'Contactează-ne',
    listTitle: 'Mentorii noștri',
    all: 'Toate',
    filter: 'Filtrează după etichetă',
    profile: 'Vezi profilul',
    emptyTitle: 'Lista mentorilor se completează',
    emptyText: 'Mentorii apar aici după ce își dau acordul să fie afișați public. Până atunci, întreabă în comunitate pe Discord.',
    discord: 'Intră pe Discord',
    becomeTitle: 'Devino mentor',
    becomeText: 'Împărtășește ce știi și ajută-i pe cei care abia încep.',
    becomeCta: 'Aplică',
  },
  en: {
    eyebrow: 'Community',
    title: 'Learn from the community',
    text: 'Guidance from experienced volunteers in the peViitor community: questions about code, career and first steps in open source.',
    contact: 'Get in touch',
    listTitle: 'Our mentors',
    all: 'All',
    filter: 'Filter by tag',
    profile: 'View profile',
    emptyTitle: 'The mentor list is being put together',
    emptyText: 'Mentors appear here once they agree to be listed publicly. Until then, ask in the community on Discord.',
    discord: 'Join Discord',
    becomeTitle: 'Become a mentor',
    becomeText: 'Share what you know and help people who are just starting.',
    becomeCta: 'Apply',
  },
}[lang];

const tags = [...new Set(mentors.flatMap((m) => m.tags))].sort((a, b) => a.localeCompare(b, lang));
const involved = translatePath('get-involved');

const card = 'rounded-2xl border border-slate-200 bg-white/70 p-6 backdrop-blur dark:border-white/10 dark:bg-white/5';
const primaryButton =
  'inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-cyan-400 to-violet-500 px-6 py-3 font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:brightness-110';
const secondaryButton =
  'inline-flex items-center justify-center gap-2 rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold transition hover:border-cyan-500 dark:border-white/20 dark:hover:border-cyan-300';
const chipBase =
  'rounded-full border px-3 py-1 text-xs font-semibold transition aria-pressed:border-cyan-500 aria-pressed:bg-cyan-500/15';
---

<div class="relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="home-grid absolute inset-0"></div>
    <div class="absolute -top-32 -left-24 h-96 w-96 rounded-full bg-cyan-400/20 blur-3xl dark:bg-cyan-500/15"></div>
    <div class="absolute top-0 -right-24 h-96 w-96 rounded-full bg-violet-400/15 blur-3xl dark:bg-violet-500/15"></div>
  </div>

  <section class="mx-auto max-w-3xl px-6 pt-12 pb-14 text-center md:pt-16">
    <p class="mb-4 font-mono text-xs font-semibold tracking-[0.2em] text-cyan-700 uppercase dark:text-cyan-300">{copy.eyebrow}</p>
    <h1 class="bg-gradient-to-r from-cyan-500 via-teal-400 to-violet-500 bg-clip-text text-4xl leading-tight font-extrabold tracking-tight text-transparent md:text-6xl dark:from-cyan-300 dark:via-sky-400 dark:to-violet-400">
      {copy.title}
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-slate-600 dark:text-slate-300">{copy.text}</p>
    <div class="mt-8">
      <a href={involved} class={primaryButton}>{copy.contact}</a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <h2 class="mb-6 text-2xl font-bold md:text-3xl dark:text-white">{copy.listTitle}</h2>

    {mentors.length > 0 && tags.length > 0 && (
      <div id="mentor-filters" class="mb-6 flex flex-wrap gap-2" role="group" aria-label={copy.filter}>
        <button type="button" data-tag="" aria-pressed="true" class={`${chipBase} border-slate-300 dark:border-white/20`}>{copy.all}</button>
        {tags.map((tag) => (
          <button type="button" data-tag={tag} aria-pressed="false" class={`${chipBase} border-slate-300 dark:border-white/20`}>{tag}</button>
        ))}
      </div>
    )}

    <ul class="grid gap-4 md:grid-cols-2">
      {mentors.map((mentor) => (
        <li class={card} data-tags={JSON.stringify(mentor.tags)}>
          <div class="mb-3 flex items-center gap-3">
            <span aria-hidden="true" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-cyan-400 to-violet-500 font-bold text-slate-950">
              {mentor.name.split(' ').map((part) => part[0]).slice(0, 2).join('').toUpperCase()}
            </span>
            <div class="min-w-0">
              <h3 class="truncate text-lg font-bold">{mentor.name}</h3>
              <p class="text-xs font-semibold tracking-wide text-cyan-700 uppercase dark:text-cyan-300">{mentor.role}</p>
            </div>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-300">{mentor.bio}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {mentor.tags.map((tag) => (
              <li class="rounded-md bg-slate-200/70 px-2 py-0.5 text-xs dark:bg-white/10">{tag}</li>
            ))}
          </ul>
          {mentor.url && (
            <a href={mentor.url} target="_blank" rel="noopener noreferrer" class={`${secondaryButton} mt-5`}>{copy.profile}</a>
          )}
        </li>
      ))}

      {mentors.length === 0 && (
        <li class={`${card} md:col-span-2`}>
          <h3 class="mb-2 text-lg font-bold">{copy.emptyTitle}</h3>
          <p class="mb-5 text-sm text-slate-600 dark:text-slate-300">{copy.emptyText}</p>
          <a href="https://discord.gg/KPMkdUfQNu" target="_blank" rel="noopener noreferrer" class={secondaryButton}>{copy.discord}</a>
        </li>
      )}

      <li class={`${card} md:col-span-2`}>
        <h3 class="mb-1 text-lg font-bold">{copy.becomeTitle}</h3>
        <p class="mb-5 text-sm text-slate-600 dark:text-slate-300">{copy.becomeText}</p>
        <a href={involved} class={secondaryButton}>{copy.becomeCta}</a>
      </li>
    </ul>
  </section>
</div>

<script>
  const filters = document.getElementById('mentor-filters');
  const cards = document.querySelectorAll<HTMLElement>('li[data-tags]');
  filters?.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('button[data-tag]');
    if (!button) return;
    const tag = button.dataset.tag ?? '';
    filters.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    cards.forEach((card) => {
      const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
      card.hidden = tag !== '' && !tags.includes(tag);
    });
  });
</script>
